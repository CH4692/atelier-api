# Copy the development connection from Neon and preserve its TLS parameters.
DATABASE_URL='postgresql+psycopg://ROLE:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require&channel_binding=require'
# Use the direct connection (without -pooler) to a separate existing test database.
TEST_DATABASE_URL='postgresql+psycopg://ROLE:PASSWORD@YOUR-ENDPOINT.neon.tech/atelier_test?sslmode=require&channel_binding=require'

# Development only: a separate HTTP cookie named dev-session.
# Production MUST use production and HTTPS on frontend and API.
ENVIRONMENT=development
# JSON arrays, exact origins, no paths, trailing slashes or wildcards.
FRONTEND_ORIGINS='["http://localhost:3000","http://127.0.0.1:8000"]'
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
LOGIN_ACCOUNT_LIMIT=10
LOGIN_IP_LIMIT=30
LOGIN_WINDOW_SECONDS=900
# Trust only your reverse proxy's actual address/network. Never use "*".
TRUSTED_PROXY_IPS='[]'
# Reserved for the future customer portal; keep disabled for the workshop.
CUSTOMER_PORTAL_AUTH_ENABLED=false
